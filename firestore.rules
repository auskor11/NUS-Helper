rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USER DATA
    // ============================================================

    // Each user can only access their own data.
    match /users/{userId}/{document=**} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }


    // ============================================================
    // GLOBAL LOCATION DATA
    // ============================================================

    // NUS venues, NUS shuttle bus stops and public bus stops
    // are shared location data.
    //
    // During development, authenticated users can read and write
    // these records.
    //
    // We will tighten WRITE permissions later when we move the
    // NUSMods/LTA import process to a trusted backend.
    // ============================================================

    match /locations/venues/items/{venueId} {

      allow read, write:
        if request.auth != null;
    }


    match /locations/nusBusStops/items/{stopId} {

      allow read, write:
        if request.auth != null;
    }


    match /locations/publicBusStops/items/{stopId} {

      allow read, write:
        if request.auth != null;
    }
  }
}